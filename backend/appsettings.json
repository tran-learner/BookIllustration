    "Audience": "BookIllustrationFrontend",
    "ExpirationMinutes": 60
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "TextModel": "gemini-3.5-flash-lite",
    "ImageModel": "gemini-3.1-flash-image"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
